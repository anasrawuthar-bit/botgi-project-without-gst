# ==============================================================================
# BOTGI DOCKER ENVIRONMENT CONFIGURATION
# Copy this file to .env before running: docker compose up -d --build
# ==============================================================================

# General Django Settings
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-this-to-a-strong-random-50-character-secret-key-in-production
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.mycompany.in,https://mycompany.in,http://localhost:8000
PUBLIC_BASE_URL=https://mycompany.in

# PostgreSQL Database Configuration
POSTGRES_DB=botgi_db
POSTGRES_USER=botgi_user
POSTGRES_PASSWORD=botgi_secure_password_replace_me_123

# WhatsApp Bridge Configuration
WA_CLIENT_ID=botgi_default
WA_HEADLESS=true

# Port to expose web application (default: 8000)
PORT=8000
