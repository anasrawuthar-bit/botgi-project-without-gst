DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,status.botgitech.com,dir.anasrawuthar.in
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com
DJANGO_SECURE_SSL_REDIRECT=True
# Optional: override secure cookie behavior directly.
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
PUBLIC_BASE_URL=https://status.botgitech.com
WEB_RELEASE_VERSION=2026.04.20.1
WEB_RELEASE_POLL_INTERVAL_SECONDS=300

# WhatsApp Bridge (optional local QR login service)
WHATSAPP_BRIDGE_AUTO_START=True
WA_BRIDGE_PORT=3001
WA_CLIENT_ID=botgi_default
WA_HEADLESS=false

# Use one of the following database options.
DATABASE_URL=postgres://postgres:1234@127.0.0.1:5432/botgi_db
# SQLITE_PATH=C:\path\to\db.sqlite3
